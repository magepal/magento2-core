{
    "name": "magepal/magento2-core",
    "description": "MagePal core extension",
    "keywords": [
        "magento 2",
        "magepal core extension"
    ],
    "license": [
        "proprietary"
    ],
    "homepage": "https://www.magepal.com/",
    "support": {
        "email": "support@magepal.com",
        "issues": "https://github.com/magepal/magento2-core/issues/"
    },
    "authors": [
        {
            "name": "Renon Stewart",
            "email": "renon@magepal.com",
            "homepage": "https://www.magepal.com/",
            "role": "Leader"
        }
    ],
    "require": {
        "magento/framework": "*"
    },
    "type": "magento2-module",
    "version": "1.1.14",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MagePal\\Core\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
